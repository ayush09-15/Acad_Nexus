# Acad Nexus Environment Configuration Overview

# Backend (.env located in backend/.env)
# PORT=5001
# MONGO_URI=mongodb://127.0.0.1:27017/acad_nexus
# JWT_SECRET=acad_nexus_dev_jwt_secret_key_2026_change_in_production
# AI_SERVICE_URL=http://127.0.0.1:8000

# AI Service (.env located in ai-service/.env)
# GEMINI_API_KEY=your_gemini_api_key_here
# GEMINI_MODEL=gemini-1.5-flash
# EMBEDDING_MODEL=models/text-embedding-004
# PINECONE_API_KEY=your_pinecone_api_key_here
# PINECONE_INDEX_NAME=acad-nexus-materials
# PORT=8000
# HOST=0.0.0.0
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5001,http://127.0.0.1:5173,http://127.0.0.1:5001
